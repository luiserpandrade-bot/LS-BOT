# Copia este archivo como backend/.env y completa los valores.
# backend/.env NO se sube a git (está en .gitignore).

# Base de datos (PostgreSQL en Docker)
POSTGRES_DB=lsbot
POSTGRES_USER=lsbot
POSTGRES_PASSWORD=cambia-esta-clave

# Firma de los JWT: una cadena larga y aleatoria.
# Para generarla:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
MINUTOS_TOKEN=60

# Asistente LS-bot. Vacío = modo reglas (sin internet ni clave).
# La clave gratuita se crea en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Solo para la práctica: habilita /pruebas/error/{codigo} (400, 401, 422, 500…).
PERMITIR_ERRORES_DE_PRUEBA=false
